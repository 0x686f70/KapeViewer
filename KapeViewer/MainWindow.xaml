<Window x:Class="KapeViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KapeViewer"
        xmlns:models="clr-namespace:KapeViewer.Models"
        xmlns:vm="clr-namespace:KapeViewer.ViewModels"
        mc:Ignorable="d"
        Title="KAPE Viewer" Height="800" Width="1200"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding FileTree.OpenCaseCommand}"/>
        <KeyBinding Key="F5" Command="{Binding FileTree.OpenCaseCommand}"/> <!-- Reusing OpenCase for Refresh for now -->
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding BuildTimelineCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding Table.ExportTableCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu Bar at top -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Case" Command="{Binding FileTree.OpenCaseCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Export Current Table" Command="{Binding Table.ExportTableCommand}" InputGestureText="Ctrl+E"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Build Global _Timeline" Command="{Binding BuildTimelineCommand}" InputGestureText="Ctrl+T"/>
                <MenuItem Header="_Export Timeline" Command="{Binding Timeline.ExportTimelineCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_UTC/Local Time" IsCheckable="True" IsChecked="{Binding Timeline.IsUtcMode, Mode=TwoWay}" Command="{Binding Timeline.ToggleUtcModeCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <!-- Action Buttons -->
                <Button Content="📁 Open Case" Command="{Binding FileTree.OpenCaseCommand}" ToolTip="Open KAPE case folder (Ctrl+O)"/>
                <Button Content="⏱️ Build Global Timeline" Command="{Binding BuildTimelineCommand}" ToolTip="Merge all CSV files into timeline (Ctrl+T)"/>
                
                <Separator/>
                
                <!-- Date Range Filters (Bound to Timeline.FilterCriteria) -->
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="5,0"/>
                <DatePicker Width="120" SelectedDate="{Binding Timeline.FilterCriteria.FromDate}" ToolTip="Filter start date"/>
                
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="5,0"/>
                <DatePicker Width="120" SelectedDate="{Binding Timeline.FilterCriteria.ToDate}" ToolTip="Filter end date"/>
                
                <ToggleButton Content="UTC" Width="50" IsChecked="{Binding Timeline.IsUtcMode}" Command="{Binding Timeline.ToggleUtcModeCommand}" ToolTip="Toggle between UTC and Local time"/>
                
                <Separator/>
                
                <!-- Quick Search -->
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox Width="200" Text="{Binding Timeline.FilterCriteria.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search timeline">
                    <TextBox.InputBindings>
                         <KeyBinding Key="Enter" Command="{Binding Timeline.ApplyFiltersCommand}"/> 
                         <!-- Note: ApplyFiltersCommand is not yet exposed as ICommand in TimelineViewModel, need to add it or use behavior -->
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="🔍" Command="{Binding Timeline.ApplyFiltersCommand}"/>

                <Separator/>
                
                <!-- Export -->
                <Button Content="💾 Export Table" Command="{Binding Table.ExportTableCommand}" ToolTip="Export current table"/>
                
                <!-- Spacer -->
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Width="Auto" HorizontalAlignment="Stretch"/>
                
                <!-- Row Count Label -->
                <TextBlock Text="{Binding Timeline.StatusMessage}" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status Bar at bottom -->
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding FileTree.CurrentCasePath}" Margin="5,0"/>
            <Separator/>
            <TextBlock Text="{Binding Table.StatusMessage}" Margin="5,0"/>
            <Separator/>
            <TextBlock Text="{Binding Timeline.StatusMessage}" Margin="5,0"/>
        </StatusBar>

        <!-- Main content area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TreeView for file navigation -->
            <TreeView Grid.Column="0" 
                      ItemsSource="{Binding FileTree.Groups}"
                      x:Name="FileTreeView">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type models:GroupNode}" 
                                              ItemsSource="{Binding Files}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text=" (" Margin="5,0,0,0"/>
                            <TextBlock Text="{Binding FileCount}"/>
                            <TextBlock Text=")"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    
                    <DataTemplate DataType="{x:Type models:CsvFileItem}">
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <!-- We need a way to bind selected item. 
                             TreeView doesn't support binding SelectedItem directly. 
                             We'll handle it in code-behind for now or use a behavior. 
                             For simplicity in this phase, I'll keep the SelectionChanged event in code-behind 
                             but forward it to ViewModel. -->
                        <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch"/>

            <!-- Right side content with TabControl -->
            <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTabIndex}">
                <!-- Table Tab -->
                <TabItem Header="Table">
                    <DataGrid ItemsSource="{Binding Table.CurrentTable}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"/>
                </TabItem>
                
                <!-- Timeline Tab -->
                <TabItem Header="Timeline">
                    <ListView ItemsSource="{Binding Timeline.FilteredEvents}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Timestamp" Width="200" DisplayMemberBinding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}"/>
                                <GridViewColumn Header="Source" Width="200" DisplayMemberBinding="{Binding Source}"/>
                                <GridViewColumn Header="GroupName" Width="150" DisplayMemberBinding="{Binding GroupName}"/>
                                <GridViewColumn Header="Description" Width="600" DisplayMemberBinding="{Binding Description}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
